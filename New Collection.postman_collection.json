    {
      "name": "List of books",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status code is 200\", function(){\r\n    pm.response.to.have.status(200);\r\n})\r\nconst response=pm.response.json();\r\nconsole.log(response)\r\n\r\nconst fictionBooks=response.filter((book)=> book.available===true);\r\nconst book =fictionBooks[0];\r\nif (book){\r\n    pm.globals.set(\"bookId\", book.id);\r\n}\r\n\r\npm.test(\"Book found\", ()=>{\r\n    pm.expect(book).to.be.an('object');\r\n    pm.expect(book.available).to.be.true;\r\n    pm.expect(book.available).to.eql(true);\r\n    pm.expect(book.type).to.eql(\"fiction\");\r\n})\r\npm.test(\"Non-fictional book is present\", () => {\r\n    pm.expect(\r\n        response.some(book => book.type === \"non-fiction\")\r\n    ).to.be.true;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "limit",
              "value": "2",
              "disabled": true
            },
            {
              "key": "type",
              "value": "fiction",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
